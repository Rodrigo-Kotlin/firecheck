# =============================================================================
# FireCheck · Supabase credentials
# =============================================================================
# These variables are exposed to the client (Vite prefix `VITE_`) and bundled
# into the production build. They identify the Supabase project and authorise
# the public anon key. NEVER commit a real .env file — only `.env.example`.
# =============================================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY


