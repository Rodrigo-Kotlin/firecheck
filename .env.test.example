# FireCheck · variáveis para testes de integração de inspeções compartilhadas
#
# Copie para `.env.test.local` (ignorado pelo git) e preencha com um projeto de
# STAGING/DEV. NUNCA use produção nem a service_role key aqui — a validação de
# RLS depende de sessões reais com a ANON KEY.
#
# Segurança: não commite este arquivo preenchido.
#
# Execução (Node 20.6+):
#   node --env-file=.env.test.local scripts/validate-inspection-sharing.mjs

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=

# Usuário admin (role admin) para setup/limpeza e casos de permissão.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Inspetor A — cria a inspeção inicial.
TEST_INSPECTOR_A_EMAIL=
TEST_INSPECTOR_A_PASSWORD=

# Inspetor B — edita a inspeção de A (caso central do compartilhamento).
TEST_INSPECTOR_B_EMAIL=
TEST_INSPECTOR_B_PASSWORD=

# (Opcional) usuário autenticado sem role admin/inspetor — valida negação.
TEST_UNAUTHORIZED_EMAIL=
TEST_UNAUTHORIZED_PASSWORD=
